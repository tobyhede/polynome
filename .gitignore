# Serena's local state: a per-developer override file and a regenerable cache.
.serena/project.local.yml
.serena/cache/

# Agent worktrees of this repository. Each is a full checkout and must not be
# staged from its parent checkout. Biome force-ignores these separately because
# its scanner gives nested configuration files priority over VCS ignores.
.worktrees/
.claude/worktrees/
